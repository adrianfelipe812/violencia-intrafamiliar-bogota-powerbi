                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "En 2025, el 77 % de los agresores fue un familiar y el 79 % de los hechos ocurrió en la vivienda.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#1F2430",
